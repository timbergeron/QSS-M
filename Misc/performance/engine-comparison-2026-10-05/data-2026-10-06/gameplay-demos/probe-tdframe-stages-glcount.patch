--- a/Quake/cl_demo.c
+++ b/Quake/cl_demo.c
@@ -4835,12 +4835,126 @@ CL_FinishTimeDemo
 
 ====================
 */
+/* PROBE: per-frame wall time during timedemo */
+unsigned int glprobe_c[GLPROBE_N];
+static struct { const char *file; int line; unsigned int n; } glprobe_sites[256];
+void glprobe_site (const char *file, int line)
+{
+	int i;
+	for (i = 0; i < 256 && glprobe_sites[i].file; i++)
+		if (glprobe_sites[i].line == line && glprobe_sites[i].file == file)
+		{
+			glprobe_sites[i].n++;
+			return;
+		}
+	if (i < 256)
+	{
+		glprobe_sites[i].file = file; glprobe_sites[i].line = line; glprobe_sites[i].n = 1;
+	}
+}
+const char *glprobe_names[GLPROBE_N] = {"glBegin","glEnd","glVertex2f","glVertex3f","glVertex3fv","glVertex2fv","glTexCoord2f","glTexCoord2fv","glColor4f","glColor4ub","glColor4ubv","glColor3f","glColor4fv","glColor3ub","glBindTexture","glEnable","glDisable","glBlendFunc","glDepthMask","glDepthFunc","glTexEnvf","glTexEnvi","glTexParameterf","glTexParameteri","glDrawArrays","glDrawElements","glMatrixMode","glLoadIdentity","glPushMatrix","glPopMatrix","glOrtho","glViewport","glScissor","glAlphaFunc","glShadeModel","glPolygonMode","glCullFace","glFrontFace","glDepthRange","glClear","glColorMask","glLoadMatrixf","glMultMatrixf","glTranslatef","glRotatef","glScalef","glEnableClientState","glDisableClientState","glVertexPointer","glTexCoordPointer","glColorPointer","glGetIntegerv","glGetFloatv","glGetError","glStencilFunc","glStencilOp","glPolygonOffset","glLineWidth","glPointSize","glHint","glFogf","glFogfv","glFogi","glTexImage2D","glTexSubImage2D","glCopyTexSubImage2D","glReadPixels","glFinish","glFlush","glGenTextures","glDeleteTextures","glPixelStorei","glClearColor"};
+double td_stage[8];
+static double td_probe_last;
+static int td_probe_n;
+static float td_probe_ms[400000];
+void TD_ProbeFrame (void)
+{
+	double now = Sys_DoubleTime ();
+	if (!cls.timedemo || host_framecount <= cls.td_startframe + 1)
+	{
+		memset (td_stage, 0, sizeof(td_stage));
+		memset (glprobe_c, 0, sizeof(glprobe_c));
+		memset (glprobe_sites, 0, sizeof(glprobe_sites));
+	}
+	if (cls.timedemo && host_framecount > cls.td_startframe + 1 && td_probe_n < (int)countof(td_probe_ms))
+	{
+		td_probe_ms[td_probe_n] = (float)((now - td_probe_last) * 1000.0);
+		if (td_probe_ms[td_probe_n] > 2.0f)
+			Con_Printf ("TDSPIKE %d %.1fms signon %d\n", td_probe_n, td_probe_ms[td_probe_n], cls.signon);
+		td_probe_n++;
+	}
+	td_probe_last = now;
+}
+static int TD_ProbeCmp (const void *a, const void *b)
+{
+	float x = *(const float *)a, y = *(const float *)b;
+	return x < y ? 1 : x > y ? -1 : 0;
+}
+static void TD_ProbeReport (void)
+{
+	static float sorted[400000];
+	double total = 0, over1 = 0, over2 = 0, med, excess = 0;
+	int i, n1 = 0, n2 = 0, n5 = 0;
+	char line[1024];
+	if (!td_probe_n) return;
+	Con_Printf ("TDPROBE stages us/frame read %.1f screen %.1f sound %.1f particles %.1f swap %.1f pscript %.1f\n",
+		td_stage[0] * 1e6 / td_probe_n, td_stage[1] * 1e6 / td_probe_n, td_stage[2] * 1e6 / td_probe_n,
+		td_stage[3] * 1e6 / td_probe_n, td_stage[4] * 1e6 / td_probe_n, td_stage[5] * 1e6 / td_probe_n);
+	memset (td_stage, 0, sizeof(td_stage));
+	{
+		unsigned int total = 0, k, j, best;
+		char glline[4000];
+		qboolean used[GLPROBE_N] = {0};
+		for (k = 0; k < GLPROBE_N; k++)
+			total += glprobe_c[k];
+		q_snprintf (glline, sizeof(glline), "TDPROBE glcalls/frame %.1f:", (double)total / td_probe_n);
+		for (j = 0; j < GLPROBE_N; j++)
+		{
+			best = GLPROBE_N;
+			for (k = 0; k < GLPROBE_N; k++)
+				if (!used[k] && glprobe_c[k] && (best == GLPROBE_N || glprobe_c[k] > glprobe_c[best]))
+					best = k;
+			if (best == GLPROBE_N)
+				break;
+			used[best] = true;
+			q_snprintf (glline + strlen (glline), sizeof(glline) - strlen (glline), " %s %.1f", glprobe_names[best], (double)glprobe_c[best] / td_probe_n);
+		}
+		Con_Printf ("%s\n", glline);
+		memset (glprobe_c, 0, sizeof(glprobe_c));
+		for (k = 0; k < 256 && glprobe_sites[k].file; k++)
+			if (glprobe_sites[k].n >= (unsigned)td_probe_n / 4)
+				Con_Printf ("TDPROBE glBegin %s:%d %.2f/frame\n", COM_SkipPath (glprobe_sites[k].file), glprobe_sites[k].line, (double)glprobe_sites[k].n / td_probe_n);
+		memset (glprobe_sites, 0, sizeof(glprobe_sites));
+	}
+	{ extern double snd_probe_filtered; Con_Printf ("TDPROBE soundfilter %.0f samples\n", snd_probe_filtered); snd_probe_filtered = 0; }
+	for (i = 0; i < td_probe_n; i++) { total += td_probe_ms[i]; sorted[i] = td_probe_ms[i]; }
+	qsort (sorted, td_probe_n, sizeof(float), TD_ProbeCmp);
+	med = sorted[td_probe_n / 2];
+	for (i = 0; i < td_probe_n; i++)
+	{
+		float v = td_probe_ms[i];
+		if (v > 1) { n1++; over1 += v; }
+		if (v > 2) { n2++; over2 += v; }
+		if (v > 5) n5++;
+		if (v > med * 3) excess += v - med;
+	}
+	Con_Printf ("TDPROBE frames %d total %.1fms median %.4fms p99 %.3fms p999 %.3fms max %.2fms >1ms %d (%.1fms) >2ms %d (%.1fms) >5ms %d excess>3xmed %.1fms\n",
+		td_probe_n, total, med, sorted[td_probe_n / 100], sorted[td_probe_n / 1000], sorted[0], n1, over1, n2, over2, n5, excess);
+	line[0] = 0;
+	for (i = 0; i < td_probe_n; i++)
+		if (td_probe_ms[i] > 1.0f && strlen (line) < 900)
+			q_snprintf (line + strlen (line), sizeof(line) - strlen (line), " %d:%.1f", i, td_probe_ms[i]);
+	Con_Printf ("TDPROBE spikes%s\n", line);
+	{
+		static int pass;
+		FILE *f = fopen (va ("%s/tdprobe_%d.txt", com_basedir, pass++), "w");
+		if (f)
+		{
+			for (i = 0; i < td_probe_n; i++)
+				fprintf (f, "%.4f\n", td_probe_ms[i]);
+			fclose (f);
+		}
+	}
+	td_probe_n = 0;
+}
+
 static void CL_FinishTimeDemo (void)
 {
 	int	frames;
 	float	time;
 
 	cls.timedemo = false;
+	TD_ProbeReport (); /* PROBE */
 
 // the first frame didn't count
 	frames = (host_framecount - cls.td_startframe) - 1;
