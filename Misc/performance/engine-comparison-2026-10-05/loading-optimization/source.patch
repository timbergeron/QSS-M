+// Return the first candidate index with an open file, preserving filename-first
+// precedence. The directory cache expires before this function returns.
+int COM_FOpenFileCandidates (const char *const *filenames, int count, FILE **file, unsigned int *path_id)
+{
+	com_file_search_cache_t cache = {0};
+	int i;
+
+	*file = NULL;
+	for (i = 0; i < count; i++)
+	{
+		COM_FindFileCached (filenames[i], NULL, file, path_id, NULL, &cache);
+		if (*file)
+			return i;
+	}
+	return -1;
+}
