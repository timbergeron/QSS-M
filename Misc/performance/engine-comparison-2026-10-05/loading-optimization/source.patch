+} com_file_search_cache_t;
+
+// Cache only parent directory availability for one candidate search. PACK
+// entries and files in existing directories still get their normal lookup.
+static int COM_FileTypeForSearch (const char *path, com_file_search_cache_t *cache)
+{
+	char parent[MAX_OSPATH];
+	const char *slash;
+#ifdef _WIN32
+	const char *backslash;
+#endif
+	size_t len;
+	unsigned int i;
+	int type;
+
+	if (!cache)
+		return Sys_FileType (path);
+
+	slash = strrchr (path, '/');
+#ifdef _WIN32
+	backslash = strrchr (path, '\\');
+	if (!slash || (backslash && backslash > slash))
+		slash = backslash;
+#endif
+	if (!slash || slash == path)
+		return Sys_FileType (path);
+
+	len = slash - path;
+	memcpy (parent, path, len);
+	parent[len] = '\0';
+	for (i = 0; i < cache->count; i++)
+		if (!strcmp (cache->dirs[i].path, parent))
+			return cache->dirs[i].exists ? Sys_FileType (path) : FS_ENT_NONE;
+
+	type = Sys_FileType (path);
+	if (type != FS_ENT_NONE || cache->count == countof(cache->dirs))
+		return type;
+
+	q_strlcpy (cache->dirs[cache->count].path, parent, sizeof(cache->dirs[0].path));
+	cache->dirs[cache->count].exists = (Sys_FileType (parent) & FS_ENT_DIRECTORY) != 0;
+	cache->count++;
+	return type;
+}
