+/*
+===============
+GL_SetLoadSync
+
+NVIDIA's threaded driver spends ~40ms warming up on the first burst of texture
+uploads after context creation. Synchronous debug output keeps the driver
+single-threaded, which avoids that, so hold it for the first level load only.
+Later loads are as fast or faster threaded, and gameplay must stay threaded.
+===============
+*/
+#ifndef GL_DEBUG_OUTPUT
+#define GL_DEBUG_OUTPUT				0x92E0
+#endif
+#ifndef GL_DEBUG_OUTPUT_SYNCHRONOUS
+#define GL_DEBUG_OUTPUT_SYNCHRONOUS	0x8242
+#endif
+typedef void (APIENTRY *gl_debugproc_t) (GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei length, const GLchar *message, const void *user);
+typedef void (APIENTRY *gl_debugmessagecallback_t) (gl_debugproc_t callback, const void *user);
+static gl_debugmessagecallback_t GL_DebugMessageCallbackFunc;
+static qboolean gl_loadsync_active, gl_loadsync_done;
+
+static void APIENTRY GL_LoadSyncMessage (GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei length, const GLchar *message, const void *user)
+{
+}
+
+void GL_SetLoadSync (qboolean loading)
+{
+	loading = loading && gl_loadsync.value && !gl_loadsync_done;
+	if (!GL_DebugMessageCallbackFunc || loading == gl_loadsync_active)
+		return;
+	gl_loadsync_active = loading;
+	if (!loading && cls.signon == SIGNONS)
+		gl_loadsync_done = true;
+	Con_DPrintf ("GL load sync %s\n", loading ? "on" : "off");
+	if (loading)
+	{
+		GL_DebugMessageCallbackFunc (GL_LoadSyncMessage, NULL);
+		glEnable (GL_DEBUG_OUTPUT);
+		glEnable (GL_DEBUG_OUTPUT_SYNCHRONOUS);
+	}
+	else
+	{
+		glDisable (GL_DEBUG_OUTPUT_SYNCHRONOUS);
+		glDisable (GL_DEBUG_OUTPUT);
+		GL_DebugMessageCallbackFunc (NULL, NULL);
+	}
+}
+
+qboolean GL_LoadSyncActive (void)
+{
+	return gl_loadsync_active;
+}
+
 /*
 ===============
 GL_EnsureGameShaders
@@ -2267,6 +2321,13 @@ static void GL_Init (void)
 
 	GL_CheckExtensions (); //johnfitz
 
+	gl_loadsync_active = gl_loadsync_done = false;
+	GL_DebugMessageCallbackFunc = NULL;
+	if (!strncmp (gl_vendor, "NVIDIA", 6) &&
+		(gl_version_major > 4 || (gl_version_major == 4 && gl_version_minor >= 3) ||
+		GL_ParseExtensionList (gl_extensions, "GL_KHR_debug")))
+		GL_DebugMessageCallbackFunc = (gl_debugmessagecallback_t) SDL_GL_GetProcAddress ("glDebugMessageCallback");
+
 #ifdef __APPLE__
 	// ericw -- enable multi-threaded OpenGL, gives a decent FPS boost.
