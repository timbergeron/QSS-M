+}
+
+void GL_FinishProbe (const char *tag) /* PROBE */
+{
+	double t;
+	if (!COM_CheckParm ("-finishprobe"))
+		return;
+	t = Sys_DoubleTime ();
+	glFinish ();
+	t = Sys_DoubleTime () - t;
+	if (t > 0.001)
+		Con_DPrintf ("FINISH %s %.1fms\n", tag, t * 1000.0);
+}
+
+void GL_WarmProbe (void) /* PROBE */
+{
+	static int frames;
+	int at = COM_CheckParm ("-warmtex");
+	if (!at || at + 1 >= com_argc || ++frames != atoi (com_argv[at + 1]))
+		return;
+	{
+		static byte pixels[128 * 128 * 4];
+		GLuint names[96];
+		int n, level, size;
+		double t = Sys_DoubleTime ();
+		glGenTextures (countof(names), names);
+		for (n = 0; n < (int)countof(names); n++)
+		{
+			glBindTexture (GL_TEXTURE_2D, names[n]);
+			for (level = 0, size = 128; size; level++, size >>= 1)
+				glTexImage2D (GL_TEXTURE_2D, level, GL_RGBA8, size, size, 0, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+		}
+		glDeleteTextures (countof(names), names);
+		glBindTexture (GL_TEXTURE_2D, 0);
+		Con_SafePrintf ("PROBE warmtex %.1fms\n", (Sys_DoubleTime () - t) * 1000.0);
+	}
 }
 
