/*
	pic_tests.qc -- precache_pic / iscachedpic / drawgetimagesize coverage.

	These exist because a CSQC mod could not load a plain gfx/whatever.tga.
	Three separate defects conspired, and each one made a *different* kind of
	missing image look like a successful load:

	  * gl_draw.c's standalone-image branch asked the texture manager for an
	    external image without TEXPREF_ALLOWMISSING, so a missing file produced
	    a real gltexture_t of size 0x0.  That got cached in menu_cachepics under
	    the requested name and stayed there until Draw_NewGame, so once a name
	    had failed, dropping the file into place and retrying kept returning the
	    poisoned entry.  drawgetimagesize said '0 0 0'.

	  * pr_ext.c sent every extensionless gfx/<name> to the wad first, and
	    Draw_PicFromWad2 reports a miss as the non-NULL pic_nul.  The external
	    fallback tested for NULL, so it never ran: gfx/foo could not reach
	    gfx/foo.tga at all, iscachedpic said true, and the qc got handed the 8x8
	    checkerboard.  drawgetimagesize said '8 8 0' -- note that this is a
	    different wrong answer from the case above, which is why the missing-image
	    checks below are split by lookup path rather than merged.

	  * precache_pic read its optional flags argument out of OFS_PARM1 without
	    consulting qcvm->argc, so a one-argument call inherited whatever float
	    the previous call left in that global.

	The fixtures (gfx/hq_direct.tga and friends) are generated by run_harness.py
	rather than committed, so the expected sizes here are the runner's.
*/

#define PIC_DIRECT		"gfx/hq_direct.tga"
#define PIC_DIRECT_NOEXT	"gfx/hq_direct"
#define PIC_DIRECT_SIZE		'32 16 0'

// deliberately absent, one per lookup path
#define PIC_MISSING_TGA		"gfx/hq_missing.tga"
#define PIC_MISSING_NOEXT	"gfx/hq_missing_noext"
#define PIC_MISSING_WAD		"hq_missing_wad"

// a real gfx.wad lump, so the wad path stays covered
#define PIC_WAD			"gfx/anum_1"

// staged into the gamedir mid-run by the runner; see cq_pic_recovery
#define PIC_LATE		"gfx/hq_late.tga"
#define PIC_LATE_SIZE		'24 8 0'

// reserved for cq_pic_default_flags; must not be named anywhere else
#define PIC_DEFAULTARG		"gfx/hq_defaultarg.tga"
#define PIC_DEFAULTARG_SIZE	'48 12 0'

// PIC_GRID / PIC_GRID_SIZE and the hq_pic_* mode switches live in
// rotpic_tests.qc, which is compiled into menu.dat as well -- see the note
// there. This file is csprogs.dat only.

//======================================================================
// resources that do exist
//======================================================================

void() cq_pic_present =
{
	// explicit extension: straight down the standalone-image path
	st_eqs("pic/direct-return", precache_pic(PIC_DIRECT, PRECACHE_PIC_TEST), PIC_DIRECT);
	st_ok("pic/direct-cached", iscachedpic(PIC_DIRECT));
	st_eqv("pic/direct-size", drawgetimagesize(PIC_DIRECT), PIC_DIRECT_SIZE);

	// no extension and no such wad lump, so this must fall through to the
	// external loader and find gfx/hq_direct.tga
	st_eqs("pic/extensionless-return",
		precache_pic(PIC_DIRECT_NOEXT, PRECACHE_PIC_TEST), PIC_DIRECT_NOEXT);
	st_ok("pic/extensionless-cached", iscachedpic(PIC_DIRECT_NOEXT));
	st_eqv("pic/extensionless-size", drawgetimagesize(PIC_DIRECT_NOEXT), PIC_DIRECT_SIZE);

	// a real wad lump still wins for an extensionless gfx/ name
	st_ok("pic/wad-return", precache_pic(PIC_WAD, PRECACHE_PIC_TEST) != "");
	st_ok("pic/wad-cached", iscachedpic(PIC_WAD));
	st_ok("pic/wad-size-nonzero", drawgetimagesize(PIC_WAD) != '0 0 0');

	// and an explicit wad request works off the bare lump name
	st_ok("pic/fromwad-bare-name",
		precache_pic("anum_1", PRECACHE_PIC_FROMWAD | PRECACHE_PIC_TEST) != "");
};

//======================================================================
// resources that do not
//
// Each of the three lookup paths used to fail differently, so they get
// separate names.  Returns are poisoned first: a check expecting "" or
// '0 0 0' passes for free if OFS_RETURN already held that.
//======================================================================

void() cq_pic_missing =
{
	// standalone image: used to cache a 0x0 placeholder and report success
	st_poisons();
	st_eqs("pic/missing-tga-test-returns-null",
		precache_pic(PIC_MISSING_TGA, PRECACHE_PIC_TEST), "");
	st_poisonf();
	st_eqf("pic/missing-tga-not-cached", iscachedpic(PIC_MISSING_TGA), 0);
	st_poisonv();
	st_eqv("pic/missing-tga-size-zero", drawgetimagesize(PIC_MISSING_TGA), '0 0 0');

	// extensionless: used to come back as pic_nul, i.e. cached and 8x8
	st_poisons();
	st_eqs("pic/missing-noext-test-returns-null",
		precache_pic(PIC_MISSING_NOEXT, PRECACHE_PIC_TEST), "");
	st_poisonf();
	st_eqf("pic/missing-noext-not-cached", iscachedpic(PIC_MISSING_NOEXT), 0);
	st_poisonv();
	st_eqv("pic/missing-noext-size-zero", drawgetimagesize(PIC_MISSING_NOEXT), '0 0 0');
	// specifically not the checkerboard's dimensions
	st_ok("pic/missing-noext-is-not-8x8",
		drawgetimagesize(PIC_MISSING_NOEXT) != '8 8 0');

	// explicit wad request: the query builtins must report the miss even though
	// drawing it still shows the missing-image diagnostic
	st_poisons();
	st_eqs("pic/missing-wad-test-returns-null",
		precache_pic(PIC_MISSING_WAD, PRECACHE_PIC_FROMWAD | PRECACHE_PIC_TEST), "");
	st_poisonf();
	st_eqf("pic/missing-wad-not-cached", iscachedpic(PIC_MISSING_WAD), 0);
	st_poisonv();
	st_eqv("pic/missing-wad-size-zero", drawgetimagesize(PIC_MISSING_WAD), '0 0 0');

	// a non-blocking precache still returns its input, but must not have cached
	// anything -- this is the case that used to look identical to success
	st_eqs("pic/missing-noblock-returns-input",
		precache_pic("gfx/hq_missing_noblock.tga"), "gfx/hq_missing_noblock.tga");
	st_poisonf();
	st_eqf("pic/missing-noblock-not-cached",
		iscachedpic("gfx/hq_missing_noblock.tga"), 0);
};

//======================================================================
// the optional flags argument
//
// precache_pic read OFS_PARM1 unconditionally, so a one-argument call saw
// whatever the previous call left there.  Prime that global with
// PICFLAG_NOLOAD (1<<31) through a two-argument qc function: OP_CALL1 sets
// qcvm->argc but does not clear the parameter globals, so the stale value
// survives into the builtin.  With the bug, the load is skipped entirely.
//
// The return value cannot detect this -- a non-blocking precache hands back
// its input either way -- so the check has to be iscachedpic.
//======================================================================

void(string unused, float poison) cq_prime_parm1 =
{
};

void() cq_pic_default_flags =
{
	// PIC_DEFAULTARG must be untouched before this point: the check is whether
	// a load happened at all, and an already-cached name answers yes no matter
	// what flags the builtin read. Nothing else in the harness may name it --
	// not even the panel, which caches PIC_GRID on the very first frame.
	st_ok("pic/default-arg-fixture-starts-uncached", !iscachedpic(PIC_DEFAULTARG));

	cq_prime_parm1("", 2147483648);
	precache_pic(PIC_DEFAULTARG);
	st_ok("pic/omitted-flags-still-loads", iscachedpic(PIC_DEFAULTARG));
	st_eqv("pic/omitted-flags-correct-size",
		drawgetimagesize(PIC_DEFAULTARG), PIC_DEFAULTARG_SIZE);
};

//======================================================================
// cache keying
//
// qcpics lookups compare the name only, so the first successful load wins the
// texflags and a later request with different flags reuses that image rather
// than building a second one.  Asserted so the behaviour is deliberate rather
// than incidental; the engine logs a developer note when it happens.
//======================================================================

void() cq_pic_flag_reuse =
{
	st_eqs("pic/reuses-entry-across-flags",
		precache_pic(PIC_DIRECT, PRECACHE_PIC_MIPMAP | PRECACHE_PIC_TEST), PIC_DIRECT);
	st_eqv("pic/reused-entry-keeps-size",
		drawgetimagesize(PIC_DIRECT), PIC_DIRECT_SIZE);
};

//======================================================================
// failed-load cleanup, run as its own engine invocation
//
// Draw_TryCachePicEx reserves a menu_cachepics slot before it loads, so the
// failure path has to release it -- both halves of that, or:
//
//   forgets menu_numcachepics--  ->  one slot leaks per attempt, and the 512th
//                                    distinct entry is a Sys_Error
//   forgets pic->name[0] = 0     ->  harmless; the decremented count means the
//                                    scan never reaches the slot again
//   forgets both                 ->  attempt 2 matches the stale name and
//                                    returns a cachepic_t whose qpic_t and
//                                    appended glpic were never written
//
// So the per-iteration return check catches the dangerous variant on the
// second pass, and the iteration count catches the leak. The leak ends in
// Sys_Error, which takes the process with it, hence the separate invocation:
// it must not be able to swallow the rest of the suite.
//======================================================================

void() cq_pic_stress =
{
	local float i, succeeded;
	local string name;

	while (i < 1024)
	{
		// A fresh name every iteration. Repeating one name cannot detect the
		// forgets-both variant: attempt 2 matches the stale name and returns
		// that cachepic_t early, so no further slots are consumed and the leak
		// never reaches the cap -- and because menu_cachepics is a zeroed
		// global, the entry reads back as 0x0 and DrawQC_PicValid rejects it,
		// so the return check does not catch it either. Distinct names make
		// both leaking variants allocate, so both hit MAX_CACHED_PICS.
		name = strcat("gfx/hq_missing_stress_", ftos(i), ".tga");
		if (precache_pic(name, PRECACHE_PIC_TEST) != "")
			succeeded = succeeded + 1;
		i = i + 1;
	}
	st_eqf("pic/stress-never-reports-success", succeeded, 0);

	// a leaked slot per attempt would have hit Sys_Error long before here;
	// prove the cache is still usable rather than merely still alive
	st_eqs("pic/stress-real-pic-still-loads",
		precache_pic(PIC_DIRECT, PRECACHE_PIC_TEST), PIC_DIRECT);
	st_eqv("pic/stress-real-pic-correct-size",
		drawgetimagesize(PIC_DIRECT), PIC_DIRECT_SIZE);
};

//======================================================================
// same-process recovery, run as its own engine invocation
//
// The engine-side point of not caching failures: a name that failed once must
// be retried, so a file appearing while the client is running is picked up
// without a vid_restart or a gamedir change.  That is the loop a content
// author is actually in, and it is the one thing a second engine run cannot
// test -- process exit clears both cache layers, so every fresh run would pass
// no matter how badly the first attempt poisoned things.
//
// run_harness.py writes PIC_LATE a couple of seconds in.  The qc asserts the
// miss first, then retries every frame until it appears or the budget runs out.
//======================================================================

float cq_late_frames;
float cq_late_start;
float cq_late_next;
float cq_late_done;

void() cq_pic_recovery_poll =
{
	if (cq_late_done)
		return;

	cq_late_frames = cq_late_frames + 1;

	if (cq_late_frames == 1)
	{
		// the budget has to be wall clock, not frames: this runs windowed with
		// no vsync, so the frame counter outruns the runner's staging delay by
		// orders of magnitude and a frame budget would expire before the file
		// ever appeared.
		cq_late_start = gettime(0);
		st_poisons();
		st_eqs("pic/late-absent-initially",
			precache_pic(PIC_LATE, PRECACHE_PIC_TEST), "");
		st_poisonf();
		st_eqf("pic/late-absent-not-cached", iscachedpic(PIC_LATE), 0);
		return;
	}

	// ~20Hz. Every miss costs a full external-image search (three prefix passes
	// x six formats, plus the .lmp), and there is no reason to run that at an
	// unlocked frame rate -- cq_pic_stress already covers the volume case.
	if (gettime(0) < cq_late_next)
		return;
	cq_late_next = gettime(0) + 0.05;

	if (precache_pic(PIC_LATE, PRECACHE_PIC_TEST) != "")
	{
		st_ok("pic/late-retry-picks-up-new-file", TRUE);
		st_eqv("pic/late-retry-correct-size",
			drawgetimagesize(PIC_LATE), PIC_LATE_SIZE);
		cq_late_done = TRUE;
	}
	else if (gettime(0) - cq_late_start > 30)
	{
		st_ok("pic/late-retry-picks-up-new-file", FALSE);
		st_ok("pic/late-retry-correct-size", FALSE);
		cq_late_done = TRUE;
	}
};
