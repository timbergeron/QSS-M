# GNU Makefile for compiling Win32 quakespasm.exe using MinGW or MinGW-w64.
# Usage: "make -f Makefile.w32"
# To cross-compile on Linux hosts, see build_cross_win32.sh.
# "make DEBUG=1" to build a debug client.
# All bundled dependencies, including SDL3, are linked statically.

### Enable/disable codecs for streaming music support
USE_CODEC_WAVE=1
USE_CODEC_FLAC=1
USE_CODEC_MP3=1
USE_CODEC_VORBIS=1
USE_CODEC_OPUS=1
# either xmp or mikmod
USE_CODEC_MIKMOD=0
USE_CODEC_XMP=1
USE_CODEC_MODPLUG=0
USE_CODEC_UMX=1

# which library to use for mp3 decoding: mad or mpg123
MP3LIB=mad
# The static dependency build supplies vorbis for ogg decoding.
VORBISLIB=vorbis

# ---------------------------
# Helper functions
# ---------------------------

check_gcc = $(shell if echo | $(CC) $(1) -Werror -S -o /dev/null -xc - > /dev/null 2>&1; then echo "$(1)"; else echo "$(2)"; fi;)

# ---------------------------

DEBUG   ?= 0
USE_ZLIB?= 1
USE_GNUTLS?= 1

# ---------------------------
# build variables
# ---------------------------

CC = gcc
CXX = g++
# SDL3 includes Windows C++ backends; keep their runtime static too.
LINKER = $(CXX)
WINDRES = windres

# Build dependencies once with: python3 Windows/build-static.py --arch x86
WINDOWS_STATIC_ROOT ?= ../build/windows-static/mingw-x86/prefix
ifneq ($(MAKECMDGOALS),clean)
ifeq ($(wildcard $(WINDOWS_STATIC_ROOT)/qssm-static.mk),)
$(error Static dependencies missing. Run python3 Windows/build-static.py --arch x86 from the repository root)
endif
include $(WINDOWS_STATIC_ROOT)/qssm-static.mk
endif

STRIP = strip

CPUFLAGS=
LDFLAGS = -m32 -mwindows -static -static-libgcc -static-libstdc++
LDFLAGS += -Wl,--large-address-aware	#don't crash out with larger hunk sizes
LDFLAGS += $(QSS_LDFLAGS)
LDFLAGS += -Wl,--no-insert-timestamp   #prevent non-determinism in the exe header. mustn't be used for dlls.
DFLAGS ?=
CFLAGS ?= -m32 -Wall -Wno-trigraphs -MMD
CFLAGS += $(call check_gcc,-std=gnu11,)
CFLAGS += $(CPUFLAGS)
CFLAGS += $(QSS_CFLAGS)
ifneq ($(DEBUG),0)
DFLAGS += -DDEBUG
CFLAGS += -g
do_strip=
else
DFLAGS += -DNDEBUG
CFLAGS += -O2
#CFLAGS += -fno-asynchronous-unwind-tables
CFLAGS += $(call check_gcc,-fweb,)
CFLAGS += $(call check_gcc,-frename-registers,)
cmd_strip=$(STRIP) $(1)
define do_strip
	$(call cmd_strip,$(1));
endef
endif

# The generated prefix supplies matching headers and actual static archives.
SDL_CFLAGS :=
SDL_LIBS :=
CFLAGS += -D_USE_WINSOCK2 $(WINDOWS_STATIC_CFLAGS)

ifneq ($(VORBISLIB),vorbis)
$(error VORBISLIB=$(VORBISLIB) is unsupported by static Windows builds; use VORBISLIB=vorbis)
endif
ifeq ($(USE_CODEC_MODPLUG),1)
$(error USE_CODEC_MODPLUG=1 is unsupported by static Windows builds; use USE_CODEC_XMP=1 or USE_CODEC_MIKMOD=1)
endif
ifneq ($(MP3LIB),mpg123)
ifneq ($(MP3LIB),mad)
$(error Invalid MP3LIB setting)
endif
endif
ifeq ($(MP3LIB),mad)
mp3_obj=snd_mp3.o snd_mp3tag.o
endif
ifeq ($(MP3LIB),mpg123)
mp3_obj=snd_mpg123.o snd_mp3tag.o
CFLAGS+= -DMP3LIB_MPG123
endif

ifeq ($(USE_CODEC_WAVE),1)
CFLAGS+= -DUSE_CODEC_WAVE
endif
ifeq ($(USE_CODEC_FLAC),1)
CFLAGS+= -DUSE_CODEC_FLAC
endif
ifeq ($(USE_CODEC_OPUS),1)
CFLAGS+= -DUSE_CODEC_OPUS
endif
ifeq ($(USE_CODEC_VORBIS),1)
CFLAGS+= -DUSE_CODEC_VORBIS
endif
ifeq ($(USE_CODEC_MP3),1)
CFLAGS+= -DUSE_CODEC_MP3
endif
ifeq ($(USE_CODEC_MIKMOD),1)
CFLAGS+= -DUSE_CODEC_MIKMOD
endif
ifeq ($(USE_CODEC_XMP),1)
CFLAGS+= -DUSE_CODEC_XMP
endif
ifeq ($(USE_CODEC_UMX),1)
CFLAGS+= -DUSE_CODEC_UMX
endif

ifeq ($(USE_ZLIB),1)
CFLAGS += -DUSE_ZLIB
endif
ifeq ($(USE_GNUTLS),1)
CFLAGS += -DUSE_GNUTLS -DGNUTLS_STATIC -DGNUTLS_INTERNAL_BUILD -D__WIN32__
endif
LIBS := $(WINDOWS_STATIC_LIBS)

ICEOBJS:= ice_gnutls.o  ice_main.o  ice_mdns.o ice_quake.o ice_sctp.o  ice_socket.o  ice_stream.o  ice_json.o  ice_md5.o  ice_sha1.o  ice_sha2.o

# ---------------------------
# objects
# ---------------------------

MUSIC_OBJS:= bgmusic.o \
	snd_codec.o \
	snd_flac.o \
	snd_wave.o \
	snd_vorbis.o \
	snd_opus.o \
	$(mp3_obj) \
	snd_mikmod.o \
	snd_modplug.o \
	snd_xmp.o \
	snd_umx.o
COMOBJ_SND := snd_voip.o snd_dma.o snd_mix.o snd_mem.o $(MUSIC_OBJS)
SYSOBJ_SND := snd_sdl.o
SYSOBJ_CDA := cd_null.o
SYSOBJ_INPUT := in_sdl.o
SYSOBJ_GL_VID:= gl_vidsdl.o
SYSOBJ_NET := net_win.o net_wins.o
SYSOBJ_SYS := pl_win.o sys_sdl_win.o
SYSOBJ_MAIN:= main_sdl.o
SYSOBJ_RES := QuakeSpasm.res

GLOBJS = \
	gl_refrag.o \
	gl_rlight.o \
	gl_rmain.o \
	gl_fog.o \
	gl_rmisc.o \
	r_part.o \
	r_part_fte.o \
	r_world.o \
	r_hulldebug.o \
	gl_screen.o \
	pong.o \
	gl_sky.o \
	gl_warp.o \
	$(SYSOBJ_GL_VID) \
	gl_draw.o \
	image.o \
	gl_texmgr.o \
	gl_mesh.o \
	r_sprite.o \
	r_alias.o \
	r_brush.o \
	gl_model.o

OBJS := strlcat.o \
	strlcpy.o \
	$(GLOBJS) \
	$(SYSOBJ_INPUT) \
	$(COMOBJ_SND) \
	$(SYSOBJ_SND) \
	$(SYSOBJ_CDA) \
	$(SYSOBJ_NET) \
	$(ICEOBJS) \
	net_address.o \
	net_hostname_cache.o \
	net_dgrm.o \
	netgraph.o \
	net_loop.o \
	net_main.o \
	chase.o \
	cl_demo.o \
	cl_input.o \
	cl_main.o \
	cl_translate.o \
	discord.o \
	mapshot.o \
	cl_parse.o \
	qwatch.o \
	cl_tent.o \
	console.o \
	iplog.o \
	keys.o \
	location.o \
	menu.o \
	update.o \
	sbar.o \
	view.o \
	wad.o \
	clipboard_sdl.o \
	cmd.o \
	common.o \
	quake_data_import.o \
	json.o \
	mdfour.o \
	fs_zip.o \
	f_modified.o \
	crc.o \
	cvar.o \
	cfgfile.o \
	host.o \
	host_cmd.o \
	mathlib.o \
	pr_cmds.o \
	pr_ext.o \
	pr_edict.o \
	pr_exec.o \
	pmove.o \
	pmovetst.o \
	sv_main.o \
	sv_move.o \
	sv_phys.o \
	sv_user.o \
	world.o \
	zone.o \
	$(SYSOBJ_SYS) $(SYSOBJ_MAIN)

# ---------------------------
# targets / rules
# ---------------------------

.PHONY:	clean debug release

DEFAULT_TARGET := quakespasm.exe
all: $(DEFAULT_TARGET)

%.o:	%.c
	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
%.o:	ice/%.c
	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
ice_json.o:	ice/json.c
	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
ice_md5.o:	ice/md5.c
	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
ice_sha1.o:	ice/sha1.c
	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
ice_sha2.o:	ice/sha2.c
	$(CC) $(DFLAGS) -c $(CFLAGS) $(SDL_CFLAGS) -o $@ $<
%.res:	../Windows/%.rc
	$(WINDRES) -I../Windows --output-format=coff --target=pe-i386 -o $@ $<

quakespasm.exe: $(OBJS) $(SYSOBJ_RES) $(WINDOWS_STATIC_ARCHIVES) $(WINDOWS_STATIC_ROOT)/qssm-static.mk ../Windows/verify-static.py
	$(LINKER) $(OBJS) $(SYSOBJ_RES) $(LDFLAGS) $(LIBS) $(SDL_LIBS) -o $@
	$(call do_strip,$@)
	python3 ../Windows/verify-static.py $@

release:	quakespasm.exe
debug:
	$(error Use "make DEBUG=1")

clean:
	$(RM) *.o *.d *.res $(DEFAULT_TARGET)

sinclude $(OBJS:.o=.d)
